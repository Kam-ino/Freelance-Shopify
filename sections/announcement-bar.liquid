{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
    <button class="announcement__close" type="button" aria-label="Close announcement" data-dismiss-announcement>
      {%- render 'icon', name: 'close' -%}
    </button>
    <script>
      try {
        if (!(window.Shopify && Shopify.designMode) && sessionStorage.getItem('enzo-announcement') === 'off') {
          document.currentScript.parentElement.remove();
        }
      } catch (e) {}
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping on orders over $150 · Gift-boxed in black & gold" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
