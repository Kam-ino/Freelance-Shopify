{%- liquid
  assign s = section.settings
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
  assign has_image = false
  if s.image != blank or s.sample_photo
    assign has_image = true
  endif
-%}
<div class="banner banner--{{ s.height }} banner--{{ s.position }}{% if s.width == 'contained' %} banner--contained{% endif %}{% unless has_image %} banner--label label-frame{% endunless %}" style="--overlay: {{ s.overlay | divided_by: 100.0 }}">
  {%- if has_image -%}
    <div class="banner__media">
      {%- if s.image != blank -%}
        {%- assign focal = 'object-position: ' | append: s.image.presentation.focal_point -%}
        {%- if is_first -%}
          {{ s.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', style: focal }}
        {%- else -%}
          {{ s.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', loading: 'lazy', style: focal }}
        {%- endif -%}
      {%- else -%}
        <img src="{{ 'enzo-lifestyle.jpg' | asset_url }}" width="900" height="900" alt="" {% if is_first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} style="object-position: 50% 58%">
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="banner__content{% unless s.width == 'contained' %} container{% endunless %}"><div class="banner__inner">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="banner__title">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<p class="banner__text">{{ s.text }}</p>{%- endif -%}
    {%- if s.button_label != blank or s.button_label_2 != blank -%}
      <div class="banner__actions">
        {%- if s.button_label != blank -%}
          <a class="btn btn--gold" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
        {%- endif -%}
        {%- if s.button_label_2 != blank -%}
          <a class="btn btn--ghost" href="{{ s.button_link_2 | default: routes.root_url }}">{{ s.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div></div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "sample_photo", "label": "Use sample brand photo when no image is selected", "default": false },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    {
      "type": "select", "id": "height", "label": "Height", "default": "large",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    {
      "type": "select", "id": "width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    {
      "type": "select", "id": "position", "label": "Text position", "default": "left",
      "options": [
        { "value": "left", "label": "Middle left" },
        { "value": "bottom", "label": "Bottom left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scent, undiluted" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Fragrance oils at 98% concentration. Composed to linger from first light to last call." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
