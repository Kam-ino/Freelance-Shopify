{%- comment -%} ponytail: sort only; add collection.filters (Search & Discovery) when the catalog outgrows a single page {%- endcomment -%}
<div class="container page">
  <header class="page-head">
    <h1 class="heading-rule">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <form class="toolbar" method="get">
      <span>{{ collection.products_count }} {{ collection.products_count | pluralize: 'scent', 'scents' }}</span>
      <label>
        <span class="visually-hidden">Sort by</span>
        <select name="sort_by" onchange="this.form.submit()">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
      <noscript><button class="link" type="submit">Apply</button></noscript>
    </form>

    <div class="grid" style="--cols: {{ section.settings.columns }}">
      {%- for product in collection.products -%}
        {%- render 'card-product', product: product -%}
      {%- else -%}
        <p class="muted" style="grid-column: 1 / -1; text-align: center">No scents here yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination: next: 'Next →', previous: '← Previous' }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 }
  ]
}
{% endschema %}
