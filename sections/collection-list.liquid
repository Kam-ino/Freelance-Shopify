<div class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="heading-rule">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="tiles" style="--cols: {{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image | default: c.products.first.featured_media.preview_image
        -%}
        <a class="tile{% unless img %} label-frame{% endunless %}" href="{{ c.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {%- if img -%}
            {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}
          {%- endif -%}
          <h3 class="tile__title">
            {{- block.settings.title | default: c.title | default: 'Collection' -}}
            <span class="tile__cta">Discover</span>
          </h3>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured collections" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
