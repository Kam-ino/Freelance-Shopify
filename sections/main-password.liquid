<div class="password">
  <div class="password__inner label-frame">
    <img src="{{ 'enzo-logo.png' | asset_url }}" width="474" height="474" alt="{{ shop.name }}">
    <p class="eyebrow" style="color: var(--gold)">{{ section.settings.eyebrow }}</p>
    {%- if shop.password_message != blank -%}<p style="margin-top: 16px">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'search-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <label class="visually-hidden" for="PasswordEmail">Email</label>
      <input class="field" id="PasswordEmail" type="email" name="contact[email]" placeholder="Your email address" required>
      <button class="btn btn--gold" type="submit">Notify me</button>
      {%- if form.posted_successfully? -%}<p class="form-success" role="status">You're on the list.</p>{%- endif -%}
    {%- endform -%}

    {%- form 'storefront_password' -%}
      <details {% if form.errors %}open{% endif %}>
        <summary>{{ 'general.password_page.login_form_heading' | t }}</summary>
        <div class="search-form">
          {{ form.errors | default_errors }}
          <label class="visually-hidden" for="StorePassword">Password</label>
          <input class="field" id="StorePassword" type="password" name="password" autocomplete="current-password" required>
          <button class="btn btn--ghost" type="submit">Enter</button>
        </div>
      </details>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" }
  ]
}
{% endschema %}
