<div class="container page">
  <header class="page-head"><h1 class="heading-rule">{{ section.settings.heading }}</h1></header>
  <div class="tiles" style="--cols: 3">
    {%- for c in collections -%}
      {%- assign img = c.featured_image | default: c.products.first.featured_media.preview_image -%}
      <a class="tile{% unless img %} label-frame{% endunless %}" href="{{ c.url }}">
        {%- if img -%}
          {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}
        {%- endif -%}
        <h2 class="tile__title">{{ c.title }}<span class="tile__cta">Discover</span></h2>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
