{%- comment -%} ponytail: related = siblings from the product's first collection; switch to /recommendations if merchandising needs it {%- endcomment -%}
{%- assign source = section.settings.collection | default: product.collections.first -%}
{%- assign shown = 0 -%}
{%- capture cards -%}
  {%- for p in source.products limit: 9 -%}
    {%- if p.id != product.id and shown < 4 -%}
      {%- render 'card-product', product: p -%}
      {%- assign shown = shown | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
  <div class="section" style="padding-top: 0">
    <div class="container">
      <h2 class="heading-rule">{{ section.settings.heading }}</h2>
      <div class="grid">{{ cards }}</div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to the product's first collection." }
  ]
}
{% endschema %}
