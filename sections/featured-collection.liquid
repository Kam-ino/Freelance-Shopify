{%- assign c = section.settings.collection -%}
<div class="section">
  <div class="container">
    <h2 class="heading-rule">{{ section.settings.heading }}</h2>
    <div class="grid" style="--cols: {{ section.settings.columns }}">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          {%- render 'card-product', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          {%- render 'card-product' -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="section-cta">
        <a class="btn" href="{{ c.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all scents" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
