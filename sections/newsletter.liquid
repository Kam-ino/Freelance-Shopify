<div class="newsletter">
  <div class="container">
    <div class="newsletter__box label-frame">
      <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="newsletter__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">Email</label>
        <input class="field" id="NewsletterEmail" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
        <button class="btn" type="submit">Sign up</button>
        {%- if form.posted_successfully? -%}
          <p class="form-success" role="status">Thank you — you're on the list.</p>
        {%- endif -%}
        {{ form.errors | default_errors }}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the House of Enzo" },
    { "type": "text", "id": "text", "label": "Text", "default": "New scents, private releases and invitations — before anyone else." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
