<div class="container account">
  <header class="page-head"><h1 class="heading-rule">My account</h1></header>
  <p style="margin-bottom: 40px">Welcome back, {{ customer.first_name | default: customer.email }}. <a class="link" href="{{ routes.account_logout_url }}">Sign out</a></p>
  <h2 class="eyebrow" style="margin-bottom: 16px">Order history</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table>
        <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %e, %Y' }}</td>
              <td>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_net_amount | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p class="muted">You haven't placed any orders yet.</p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
  {%- if customer.default_address -%}
    <h2 class="eyebrow" style="margin: 56px 0 16px">Default address</h2>
    <p>{{ customer.default_address | format_address }}</p>
  {%- endif -%}
</div>
