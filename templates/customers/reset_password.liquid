<div class="container container--narrow account">
  <header class="page-head"><h1 class="heading-rule">Reset password</h1></header>
  {%- form 'reset_customer_password', class: 'form-stack' -%}
    {{ form.errors | default_errors }}
    <label>New password<input class="field" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label>Confirm password<input class="field" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <p><button class="btn" type="submit">Reset password</button></p>
  {%- endform -%}
</div>
