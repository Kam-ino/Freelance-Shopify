  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M14 21v-8h3l.5-3.5H14V7.5c0-1 .4-1.8 1.9-1.8H18V2.6A25 25 0 0 0 15.2 2.4C12.5 2.4 10.6 4 10.6 7v2.5H7.5V13h3.1v8"/></svg>
